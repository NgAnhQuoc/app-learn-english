{
  "name": "co-minh-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tw:build": "tailwindcss -i ./app/tailwind.css -o ./app/tailwind-built.css",
    "tw:watch": "tailwindcss -i ./app/tailwind.css -o ./app/tailwind-built.css --watch",
    "dev": "npm run tw:build && dotenv -e .env.local -- next dev",
    "dev:clean": "rm -rf .next && npm run dev",
    "build": "npm run tw:build && next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@ai-sdk/openai": "^0.0.66",
    "@ant-design/icons": "^5.6.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@supabase/supabase-js": "^2.100.1",
    "@tailwindcss/postcss": "^4.2.2",
    "ai": "^3.4.33",
    "antd": "^5.24.5",
    "cheerio": "^1.2.0",
    "next": "16.2.1",
    "openai": "^4.104.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "sass": "^1.83.1",
    "typescript": "^5"
  }
}
